# Copy this file to .env in the root directory and fill in your values.
# Do not commit .env (it is gitignored).

# --- Frontend (Vite) - required for Firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Frontend - optional ---
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Backend (Cloud Functions / emulator) ---
# Used when running Firebase Functions locally (npm run dev:backend).
# Same .env is loaded by the backend via dotenv when using the emulator.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENCRYPTION_KEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
